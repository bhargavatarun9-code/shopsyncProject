# true   = use built-in mock data (works without the backend)
# hybrid = real backend for what's built so far (/health), mock data for the rest
# false  = call the real FastAPI backend under /api/v1 (needs every endpoint)
VITE_USE_MOCKS=true

# Leave empty in dev (Vite proxies /api to http://localhost:8000).
# In production set it to the API origin, e.g. https://api.shopsync.in
VITE_API_BASE_URL=
