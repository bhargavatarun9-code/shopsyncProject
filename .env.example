# Copy to .env and adjust.
APP_NAME="ShopSync API"
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
DOCS_ENABLED=true

# Comma-separated or JSON list. No wildcard (auth cookies need explicit origins).
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://shopsync:shopsync@localhost:5432/shopsync
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=1800
HEALTH_CHECK_TIMEOUT_SECONDS=2
